{
  "name": "academia-erp",
  "version": "1.0.0",
  "description": "Gamified ERP System for Academic Management and Student Engagement",
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"magenta,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm run dev",
    "setup": "npm --prefix backend install && npm --prefix frontend install",
    "seed": "npm --prefix backend run seed",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:ai": "cd ai-service && uvicorn main:app --reload --port 8000",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "npm --prefix backend test"
  },
  "keywords": [
    "erp",
    "gamification",
    "education",
    "stylometrics",
    "react",
    "typescript"
  ],
  "author": "Ayush Srivastava",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
