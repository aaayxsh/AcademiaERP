PORT=5000
NODE_ENV=development
# Choose between PostgreSQL (Supabase) or local SQLite:
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]"
# Or for local SQLite: DATABASE_URL="file:./dev.db"

JWT_SECRET="replace-with-a-random-64-character-secret"
JWT_EXPIRES_IN="7d"

AI_SERVICE_URL="http://localhost:8000"
CLIENT_URL="http://localhost:5173"
