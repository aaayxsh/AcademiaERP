datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         String    // STUDENT, FACULTY, ADMIN
  status       String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  firstName    String
  lastName     String
  avatarUrl    String?
  department   String?
  phone        String?
  otpCode      String?
  otpExpiresAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  studentProfile StudentProfile?
  facultyProfile FacultyProfile?
  notifications  Notification[]
  auditLogs      AuditLog[]
  notices        Notice[]
}

model StudentProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  studentId        String   @unique // Roll number e.g. STU2026CS042
  semester         Int      @default(6)
  section          String   @default("A")
  enrollmentYear   Int      @default(2023)
  lifetimeXp       Int      @default(0)
  monthlyXp        Int      @default(0)
  semesterXp       Int      @default(0)
  currentStreak    Int      @default(0)
  longestStreak    Int      @default(0)
  lastActivityDate DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments      Enrollment[]
  submissions      Submission[]
  attendanceRecords AttendanceRecord[]
  xpTransactions   XpTransaction[]
  achievements     StudentAchievement[]
  redemptions      RewardRedemption[]
}

model FacultyProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  facultyId      String   @unique // e.g. FAC2026CS01
  designation    String   @default("Assistant Professor")
  officeRoom     String?
  specialization String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses        Course[]
  grades         Grade[]
  dispositions   FacultyReviewDisposition[]
}

model AcademicTerm {
  id        String   @id @default(uuid())
  name      String   // e.g. Spring 2026
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  courses   Course[]
}

model Course {
  id          String   @id @default(uuid())
  code        String   @unique // CS301
  name        String   // Design & Analysis of Algorithms
  credits     Int      @default(4)
  department  String   @default("Computer Science & Engineering")
  semester    Int      @default(6)
  termId      String
  facultyId   String?
  syllabus    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  term        AcademicTerm      @relation(fields: [termId], references: [id])
  faculty     FacultyProfile?   @relation(fields: [facultyId], references: [id])
  enrollments Enrollment[]
  assignments Assignment[]
  attendanceSessions AttendanceSession[]
  timetableEntries TimetableEntry[]
  notices     Notice[]
}

model Enrollment {
  id         String   @id @default(uuid())
  studentId  String
  courseId   String
  status     String   @default("ENROLLED") // ENROLLED, COMPLETED, DROPPED
  enrolledAt DateTime @default(now())

  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model Assignment {
  id                   String   @id @default(uuid())
  courseId             String
  title                String
  description          String
  maxMarks             Float    @default(100.0)
  dueDate              DateTime
  permittedTypes       String   @default("PDF,DOCX")
  attachmentUrl        String?
  status               String   @default("PUBLISHED") // DRAFT, PUBLISHED, CLOSED
  allowLateSubmissions Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  course               Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions          Submission[]
}

model Submission {
  id               String   @id @default(uuid())
  assignmentId     String
  studentId        String
  fileUrl          String
  originalFileName String
  fileSizeBytes    Int      @default(0)
  fileType         String   @default("PDF")
  textContent      String?
  status           String   @default("SUBMITTED") // SUBMITTED, LATE, GRADED
  isLate           Boolean  @default(false)
  submittedAt      DateTime @default(now())

  assignment       Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student          StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grade            Grade?
  aiAssessment     AiAssessment?

  @@unique([assignmentId, studentId])
}

model Grade {
  id              String   @id @default(uuid())
  submissionId    String   @unique
  facultyId       String
  marksObtained   Float
  maxMarks        Float
  feedback        String?
  rubricBreakdown String?
  gradedAt        DateTime @default(now())

  submission      Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  faculty         FacultyProfile @relation(fields: [facultyId], references: [id])
}

model AttendanceSession {
  id          String   @id @default(uuid())
  courseId    String
  date        DateTime
  title       String   @default("Regular Lecture")
  createdAt   DateTime @default(now())

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  records     AttendanceRecord[]
}

model AttendanceRecord {
  id         String   @id @default(uuid())
  sessionId  String
  studentId  String
  status     String   @default("PRESENT") // PRESENT, ABSENT, LATE, EXCUSED
  remarks    String?
  xpAwarded  Boolean  @default(false)
  markedAt   DateTime @default(now())

  session    AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student    StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
}

model TimetableEntry {
  id          String @id @default(uuid())
  courseId    String
  dayOfWeek   String // MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY
  startTime   String // "09:00"
  endTime     String // "10:00"
  roomNo      String // "Lab 302" or "Lecture Hall 4"
  sessionType String @default("LECTURE") // LECTURE, LAB, TUTORIAL

  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Notice {
  id            String   @id @default(uuid())
  title         String
  content       String
  authorId      String
  targetRole    String   @default("ALL") // ALL, STUDENT, FACULTY
  courseId      String?
  priority      String   @default("NORMAL") // NORMAL, HIGH, URGENT
  attachmentUrl String?
  createdAt     DateTime @default(now())

  author        User     @relation(fields: [authorId], references: [id])
  course        Course?  @relation(fields: [courseId], references: [id])
}

model XpRule {
  id          String   @id @default(uuid())
  ruleKey     String   @unique // ON_TIME_SUBMISSION, ATTENDANCE_STREAK, etc.
  title       String
  description String
  basePoints  Int
  ruleVersion Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model XpTransaction {
  id             String   @id @default(uuid())
  studentId      String
  eventType      String   // ON_TIME_SUBMISSION, ATTENDANCE_MILESTONE, STREAK_BONUS
  sourceEntity   String   // submission, attendance_record
  sourceId       String   // foreign id
  amount         Int
  ruleKey        String
  ruleVersion    Int      @default(1)
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String   @id @default(uuid())
  code        String   @unique // STREAK_7_DAYS, PERFECT_ATTENDANCE
  title       String
  description String
  icon        String   // Lucide icon name e.g. "Flame", "Award", "Clock"
  category    String   // ATTENDANCE, ASSIGNMENT, CONSISTENCY, ENGAGEMENT
  xpThreshold Int      @default(0)
  tier        String   @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM
  createdAt   DateTime @default(now())

  studentAchievements StudentAchievement[]
}

model StudentAchievement {
  id            String   @id @default(uuid())
  studentId     String
  achievementId String
  unlockedAt    DateTime @default(now())

  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  achievement   Achievement    @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([studentId, achievementId])
}

model RewardItem {
  id          String   @id @default(uuid())
  title       String
  description String
  xpCost      Int
  category    String   // ACADEMIC_PERK, CAMPUS_PRIVILEGE, MERCHANDISE
  icon        String   // "BookOpen", "Coffee", "Award", "Ticket"
  stock       Int      @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  redemptions RewardRedemption[]
}

model RewardRedemption {
  id           String    @id @default(uuid())
  studentId    String
  rewardItemId String
  xpSpent      Int
  status       String    @default("APPROVED") // PENDING, APPROVED, CLAIMED
  claimedAt    DateTime?
  createdAt    DateTime  @default(now())

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rewardItem   RewardItem     @relation(fields: [rewardItemId], references: [id], onDelete: Cascade)
}

model AiAssessment {
  id                 String    @id @default(uuid())
  submissionId       String    @unique
  status             String    @default("COMPLETED") // PENDING, COMPLETED, FAILED, INSUFFICIENT_EVIDENCE
  aiLikelihoodScore  Float     @default(0.0) // 0.0 to 1.0
  confidence         String    @default("LOW") // LOW, MODERATE, HIGH
  signalsJson        String    // JSON string containing metrics
  disclaimer         String    @default("Heuristic stylometric indicator only. Does not constitute proof of academic misconduct.")
  processingTimeMs   Int       @default(0)
  modelVersion       String    @default("stylometry-nlp-v1.2")
  analyzedAt         DateTime  @default(now())

  submission         Submission                 @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  facultyDispositions FacultyReviewDisposition[]
}

model FacultyReviewDisposition {
  id                String   @id @default(uuid())
  assessmentId      String
  submissionId      String
  facultyId         String
  disposition       String   // DISMISSED, CONFIRMED_ORIGINAL, FLAGGED_FOR_ORAL_DEFENSE, REVISION_REQUESTED
  facultyNotes      String
  decisionTimestamp DateTime @default(now())

  assessment        AiAssessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  faculty           FacultyProfile @relation(fields: [facultyId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("ANNOUNCEMENT") // ASSIGNMENT, ATTENDANCE, XP_AWARD, ANNOUNCEMENT, GRADE
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  role        String?
  action      String   // LOGIN, ROLE_CHANGE, ATTENDANCE_UPDATE, GRADE_ASSIGN, XP_RULE_UPDATE, etc.
  entityType  String   // User, Grade, Attendance, XpRule, AiReview
  entityId    String?
  detailsJson String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}
